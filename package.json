{
  "name": "jobagent",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev:agent": "eve dev",
    "build:agent": "eve build",
    "deploy": "eve deploy",
    "eval": "eve eval",
    "start": "eve start",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check",
    "typecheck": "svelte-kit sync && tsc",
    "browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/browser.ps1",
    "test": "vitest run",
    "test:browser": "uv run --python 3.12 --project browser-service pytest browser-service/tests -q",
    "test:all": "npm run test && npm run test:browser"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.90",
    "@lucide/svelte": "^1.52.0",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.128",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "eve": "^0.72.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "jszip": "^3.10.2",
    "just-bash": "^3.6.0",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
