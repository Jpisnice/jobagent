{
  // $app/tsconfig is generated by `svelte-kit sync` (run on install by the prepare script).
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node", "eve/workflow-modules", "$app/types"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "src"
  ],
  // Generated shadcn-svelte barrels re-export from .svelte modules, which only svelte-check can read.
  "exclude": ["src/service-worker", "src/lib/components/ui"]
}
