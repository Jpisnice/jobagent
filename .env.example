# Copy to .env and fill in. .env is git-ignored.

# --- Required -------------------------------------------------------------
# Gemini key for the agent and the browser service (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email alerts through Resend (resend.com). onboarding@resend.dev only delivers to your own Resend address.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Any long random string; protects the local browser service (npm run browser)
BROWSER_SERVICE_TOKEN=

# --- Optional (defaults in brackets) --------------------------------------
# Where alerts go [the email on your profile]
# ALERT_TO_EMAIL=

# Models [gemini-3-flash-preview] [gemini-3.1-flash-lite]
# GEMINI_MODEL=
# GEMINI_MATCHER_MODEL=

# Browser service [http://127.0.0.1:8765] [http://127.0.0.1:9222]
# BROWSER_SERVICE_URL=
# BROWSER_CDP_URL=
# BROWSER_USE_MODEL=gemini-3-flash-preview
# BROWSER_USE_FALLBACK_MODEL=gemini-2.5-flash
# Faster but skips checking each action worked, so more dropdowns and Yes/No buttons get missed.
# BROWSER_USE_FLASH=false

# Chrome [auto-detected] [9222] [.chrome-profile]
# CHROME_PATH=
# CHROME_DEBUG_PORT=
# CHROME_PROFILE_DIR=

# File locations [data/profile.json] [.data/jobs.json] [data/]
# PROFILE_PATH=
# JOB_STORE_PATH=
# DATA_DIR=
